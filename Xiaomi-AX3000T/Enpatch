REQUIRE_IMAGE_METADATA=1

xiaomi_initial_setup() {
	[ "$(rootfs_type)" = "tmpfs" ] || return 0

	local mtdnum="$(find_mtd_index ubi)"
	local kern_mtdnum="$(find_mtd_index ubi_kernel)"

	[ -n "$mtdnum" ] || {
		echo "unable to find mtd partition ubi"
		return 1
	}

	[ -n "$kern_mtdnum" ] || {
		echo "unable to find mtd partition ubi_kernel"
		return 1
	}

	ubidetach -m "$mtdnum"
	ubiformat /dev/mtd$mtdnum -y

	ubidetach -m "$kern_mtdnum"
	ubiformat /dev/mtd$kern_mtdnum -y

	if fw_printenv -n flag_try_sys2_failed >/dev/null 2>&1; then
		fw_setenv boot_wait on
		fw_setenv uart_en 1
		fw_setenv flag_boot_rootfs 0
		fw_setenv flag_last_success 1
		fw_setenv flag_boot_success 1
		fw_setenv flag_try_sys1_failed 8
		fw_setenv flag_try_sys2_failed 8

		fw_setenv mtdparts \
			"nmbm0:1024k(bl2),256k(Nvram),256k(Bdata),2048k(factory),2048k(fip),256k(crash),256k(crash_log),34816k(ubi),34816k(ubi1),32768k(overlay),12288k(data),256k(KF)"
	fi
}

platform_do_upgrade() {
	case "$(board_name)" in
	xiaomi,mi-router-ax3000t)
		CI_KERN_UBIPART="ubi_kernel"
		CI_ROOT_UBIPART="ubi"
		nand_do_upgrade "$1"
		;;
	*)
		echo "Unsupported board: $(board_name)"
		return 1
		;;
	esac
}

PART_NAME=firmware

platform_check_image() {
	case "$(board_name)" in
	xiaomi,mi-router-ax3000t)
		nand_do_platform_check "$(board_name)" "$1"
		;;
	*)
		echo "Unsupported board: $(board_name)"
		return 1
		;;
	esac
}

platform_pre_upgrade() {
	case "$(board_name)" in
	xiaomi,mi-router-ax3000t)
		xiaomi_initial_setup
		;;
	esac
}
