#
# Target (AX3000T - MT7981 Filogic)
#
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t=y
# CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t-ubootmod is not set

#
# Base system
#
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_logd=y
CONFIG_PACKAGE_procd-ujail=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_urandom-seed=y
CONFIG_PACKAGE_urngd=y

#
# Network stack
#
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_miniupnpd=y

#
# TLS / HTTP / WiFi base
#
CONFIG_PACKAGE_libustream-mbedtls=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_uclient-fetch=y

#
# Storage / system tools
#
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_fstools=y

#
# Kernel modules (MT7981 platform)
#
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_mt7981-wo-firmware=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_kmod-leds-gpio=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-crypto-hw-safexcel=y

#
# SSH access
#
CONFIG_PACKAGE_dropbear=y

#
# LuCI FULL interface
#
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-app-upnp=y

#
# LuCI languages 
#
CONFIG_LUCI_LANG_fr=y
CONFIG_LUCI_LANG_de=y
CONFIG_LUCI_LANG_it=y
CONFIG_LUCI_LANG_es=y
CONFIG_LUCI_LANG_ru=y

#
# Web terminal
#
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y

#
# Network tools
#
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_tcpdump=y

#
# WiFi tools
#
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_luci-app-wireless=y

#
# UBI / NAND tools
#
CONFIG_PACKAGE_kmod-mtd-rw=y
CONFIG_PACKAGE_libubi=y
CONFIG_PACKAGE_ubi-utils=y
