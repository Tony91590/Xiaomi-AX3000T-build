#
# Target (AX3000T - MT7981 Filogic)
#
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t=y
# CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t-ubootmod is not set
CONFIG_KERNEL_VERMAGIC="5a6c1f71be683ae9980b15d3ce73e24d"

#
# LuCI - Langues
#
CONFIG_LUCI_LANG_fr=y
CONFIG_LUCI_LANG_de=y
CONFIG_LUCI_LANG_it=y
CONFIG_LUCI_LANG_es=y
CONFIG_LUCI_LANG_ru=y


CONFIG_PACKAGE_kmod-mtd-rw=y
CONFIG_PACKAGE_kmod-crypto-hw-safexcel=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_kmod-leds-gpio=y
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_kmod-nf-nathelper=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_mt7981-wo-firmware=y
